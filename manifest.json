{
  "manifest_version": 3,
  "name": "Personal Dashboard — New Tab",
  "version": "1.0.0",
  "description": "Replace the default New Tab page with a customizable dashboard: wallpapers, sticky notes, world clocks, quotes, and to-do lists.",
  "minimum_chrome_version": "102",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Personal Dashboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
